#!/bin/bash
# ─────────────────────────────────────────────────────────────────────────────
# s&box Native Linux — Server Launch Script
#
# Called by the egg's STARTUP command (via entrypoint.sh).
# The entrypoint handles SteamCMD updates and LD_LIBRARY_PATH.
# This script builds server arguments and launches the server.
#
# Startup detection string: "[sbox] Launching" or "Loading game"
# ─────────────────────────────────────────────────────────────────────────────

cd /home/container

# ─── Ensure LD_LIBRARY_PATH (safety net if called outside entrypoint) ───────
if [ -d "./bin/linuxsteamrt64" ]; then
    case ":${LD_LIBRARY_PATH:-}:" in
        *":/home/container/bin/linuxsteamrt64:"*) ;;
        *) export LD_LIBRARY_PATH="/home/container/bin/linuxsteamrt64:${LD_LIBRARY_PATH:-}" ;;
    esac
fi

# ─── .NET Config ─────────────────────────────────────────────────────────────
export DOTNET_ROOT="${DOTNET_ROOT:-/usr/share/dotnet}"
export DOTNET_gcServer=1
export DOTNET_GCHeapHardLimit=0x0

# ─── OpenSSL ABI Fix (safety net if called outside entrypoint) ──────────────
# Steam's bundled OpenSSL in bin/linuxsteamrt64/ conflicts with system OpenSSL 3.
# LD_PRELOAD ensures .NET uses the system's version for working TLS.
if [ -z "${LD_PRELOAD}" ] && [ -f "/usr/lib/x86_64-linux-gnu/libcrypto.so.3" ]; then
    export LD_PRELOAD="/usr/lib/x86_64-linux-gnu/libcrypto.so.3:/usr/lib/x86_64-linux-gnu/libssl.so.3"
fi

# ─── Build Server Arguments ──────────────────────────────────────────────────
ARGS=""

# Game mode / project
if [ -n "${SBOX_PROJECT}" ] && [ -f "/home/container/projects/${SBOX_PROJECT}" ]; then
    ARGS="+game /home/container/projects/${SBOX_PROJECT}"
elif [ -n "${SBOX_PROJECT}" ] && [ -f "/home/container/projects/${SBOX_PROJECT}.sbproj" ]; then
    ARGS="+game /home/container/projects/${SBOX_PROJECT}.sbproj"
elif [ -n "${GAME}" ]; then
    ARGS="+game ${GAME}"
fi

# Map
[ -n "${MAP}" ] && ARGS="${ARGS} ${MAP}"

# Server name
[ -n "${SERVER_NAME}" ] && ARGS="${ARGS} +hostname \"${SERVER_NAME}\""

# Game server token
[ -n "${TOKEN}" ] && ARGS="${ARGS} +net_game_server_token ${TOKEN}"

# Max players
if [ -n "${MAX_PLAYERS}" ] && [ "${MAX_PLAYERS}" -gt 0 ] 2>/dev/null; then
    ARGS="${ARGS} +maxplayers ${MAX_PLAYERS}"
fi

# Direct connect (bypass SDR)
if [ "${ENABLE_DIRECT_CONNECT}" = "1" ]; then
    ARGS="${ARGS} +net_hide_address 0 +port ${SERVER_PORT:-27015}"
    [ -n "${QUERY_PORT}" ] && ARGS="${ARGS} +net_query_port ${QUERY_PORT}"
fi

# Extra args
[ -n "${SBOX_EXTRA_ARGS}" ] && ARGS="${ARGS} ${SBOX_EXTRA_ARGS}"

# ─── Terminal size fix ──────────────────────────────────────────────────────
# s&box calls Console.WindowWidth which returns -1 in some container
# environments, causing ArgumentOutOfRangeException. Ensure terminal size
# is set before launching the server.
export TERM="${TERM:-xterm}"
export COLUMNS="${COLUMNS:-80}"
export LINES="${LINES:-24}"
stty columns 80 rows 24 2>/dev/null || true

# ─── Launch ──────────────────────────────────────────────────────────────────
# Background watchdog emits "Server started" after 30s for Wings startup detection.
# s&box's console uses cursor positioning that garbles the output, making Wings
# unable to match detection strings in the normal output stream.
(sleep 30 && echo "" && echo "Server started" && echo "") &

if [ -f "./sbox-server.dll" ]; then
    echo "[sbox] Launching via dotnet: dotnet sbox-server.dll ${ARGS}"
    eval dotnet sbox-server.dll ${ARGS}
elif [ -x "./sbox-server" ]; then
    echo "[sbox] Launching native binary: ./sbox-server ${ARGS}"
    eval ./sbox-server ${ARGS}
else
    echo "[sbox] ERROR: No server binary found!"
    echo "[sbox] Expected sbox-server.dll or sbox-server in /home/container/"
    echo "[sbox] Make sure SRCDS_APPID is set to 1892930 and auto-update ran."
    echo ""
    echo "[sbox] Files present:"
    ls -la *.dll *.exe 2>/dev/null || echo "  (no dll/exe files)"
    ls -d bin/*/ 2>/dev/null || echo "  (no bin/ subdirs)"
    echo ""
    echo "[sbox] Sleeping 5 minutes to prevent crash loop..."
    sleep 300
    exit 1
fi
